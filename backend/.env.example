# NutriTrack Backend Environment Template
APP_ENV=development
APP_NAME="NutriTrack API"
APP_SECRET_KEY=your_64_character_hex_app_secret_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nutriTrack?retryWrites=true&w=majority
MONGODB_DATABASE=nutriTrack

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Secrets (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
ACCESS_TOKEN_SECRET=your_64_character_hex_access_token_secret_here
REFRESH_TOKEN_SECRET=your_64_character_hex_refresh_token_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_STORAGE_BUCKET=uploads
OCR_ENGINE=tesseract
