# ==============================================================================
# NutriTrack - Git Ignore Specification
# Full-Stack FastAPI (Python) + React Vite (TypeScript/Tailwind)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Python & Backend Artefacts
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Testing, Coverage & Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Mypy, Ruff & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Artefacts (React + Vite)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Production Build Output
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
out/
.next/

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite, TypeScript & Cache
.vite/
frontend/.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 4. Runtime Uploads & Dynamic Generated Files
# ------------------------------------------------------------------------------
# Runtime user uploads (keep directory with .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Generated Reports & Temporary Export Outputs
backend/reports/generated/*
!backend/reports/generated/.gitkeep
*.tmp
*.temp

# Database dumps / backups
*.sqlite3
*.db
backend/backups/*
!backend/backups/.gitkeep

# ------------------------------------------------------------------------------
# 5. OS-Specific & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory

# IDEs & Code Editors
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Visual Studio Code (ignore user settings, keep project recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
